{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "arxiv-mcp-server",
  "version": "1.5.3",
  "description": "Search arXiv, fetch paper metadata, and read full-text content via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/arxiv-mcp-server#readme",
  "repository": "git+https://github.com/cyanheads/arxiv-mcp-server.git",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "arxiv",
    "academic-papers",
    "research",
    "typescript"
  ],
  "mcpServers": {
    "arxiv-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/arxiv-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
