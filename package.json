{
  "name": "@cyanheads/arxiv-mcp-server",
  "version": "1.2.16",
  "description": "Search arXiv, fetch paper metadata, and read full-text content via MCP. STDIO or Streamable HTTP.",
  "mcpName": "io.github.cyanheads/arxiv-mcp-server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "arxiv-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CLAUDE.md",
    "Dockerfile",
    "manifest.json",
    ".mcpbignore",
    "server.json",
    "scripts/arxiv-mirror-init.ts",
    "scripts/arxiv-mirror-refresh.ts",
    "scripts/arxiv-mirror-verify.ts",
    "scripts/_mirror-context.ts"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "rebuild": "bun scripts/clean.ts && bun scripts/build.ts",
    "clean": "bun scripts/clean.ts",
    "devcheck": "bun scripts/devcheck.ts",
    "tree": "bun scripts/tree.ts",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "lint:mcp": "bun scripts/lint-mcp.ts",
    "lint:packaging": "bun scripts/lint-packaging.ts",
    "list-skills": "bun scripts/list-skills.ts",
    "audit:refresh": "rm -f bun.lock && bun install && bun audit",
    "changelog:build": "bun scripts/build-changelog.ts",
    "changelog:check": "bun scripts/build-changelog.ts --check",
    "bundle": "bun run build && bunx -y @anthropic-ai/mcpb pack . dist/arxiv-mcp-server.mcpb && bun run scripts/clean-mcpb.ts dist/arxiv-mcp-server.mcpb",
    "test": "vitest run",
    "release:github": "bun scripts/release-github.ts",
    "publish-mcp": "mcp-publisher login github -token \"$(security find-generic-password -a \"$USER\" -s mcp-publisher-github-pat -w)\" && mcp-publisher publish",
    "start": "node dist/index.js",
    "start:stdio": "MCP_TRANSPORT_TYPE=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT_TYPE=http node dist/index.js",
    "mirror:init": "bun scripts/arxiv-mirror-init.ts",
    "mirror:refresh": "bun scripts/arxiv-mirror-refresh.ts",
    "mirror:verify": "bun scripts/arxiv-mirror-verify.ts"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "arxiv",
    "academic-papers",
    "research",
    "typescript",
    "bun",
    "stdio",
    "streamable-http"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyanheads/arxiv-mcp-server.git"
  },
  "homepage": "https://github.com/cyanheads/arxiv-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/cyanheads/arxiv-mcp-server/issues"
  },
  "author": "Casey Hand <casey@caseyjhand.com> (https://caseyjhand.com)",
  "license": "Apache-2.0",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/cyanheads"
    },
    {
      "type": "buy_me_a_coffee",
      "url": "https://www.buymeacoffee.com/cyanheads"
    }
  ],
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.11.0",
    "better-sqlite3": "^13.0.1",
    "fast-xml-parser": "^5.10.1",
    "node-cron": "^4.6.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@opentelemetry/api": "^1.9.1",
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/node-cron": "^3.0.11",
    "depcheck": "^1.4.7",
    "ignore": "^7.0.6",
    "tsc-alias": "^1.9.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
