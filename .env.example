# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=localhost           # HTTP host (default: localhost)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_ALLOWED_ORIGINS=              # Comma-separated browser Origins (default: loopback only — localhost, 127.0.0.1, [::1]). Set to '*' to disable Origin validation.

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
# MCP_SESSION_MODE=stateless        # auto | stateful | stateless (framework default: auto, which resolves to stateful)

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP endpoint URL (e.g., http://localhost:4318)

# ── arXiv ─────────────────────────────────────────────────────────────
# ARXIV_API_BASE_URL=https://export.arxiv.org/api  # arXiv API base URL
# ARXIV_REQUEST_DELAY_MS=3000                       # Min delay between API requests (ms)
# ARXIV_CONTENT_TIMEOUT_MS=30000                    # Timeout for HTML content fetches (ms)
# ARXIV_API_TIMEOUT_MS=15000                        # Timeout for API requests (ms)

# ── Optional OAI-PMH mirror ───────────────────────────────────────────
# ARXIV_MIRROR_ENABLED=false                 # Serve search and metadata from a completed local harvest
# ARXIV_MIRROR_PATH=./data/arxiv-mirror.db    # SQLite database path
# ARXIV_MIRROR_REFRESH_CRON=                  # Optional UTC cron schedule (HTTP only)
# ARXIV_MIRROR_FALLBACK_LIVE=true             # Fetch metadata misses from the live API
# ARXIV_MIRROR_RECENT_DAYS_LIVE=2             # Positive values route submitted-descending searches live
# ARXIV_MIRROR_OAI_BASE_URL=https://oaipmh.arxiv.org/oai
# ARXIV_MIRROR_OAI_REQUEST_DELAY_MS=3000      # Delay between OAI-PMH requests (ms)
# ARXIV_MIRROR_REFRESH_TIMEOUT_MS=7200000     # Scheduled refresh subprocess budget (ms)
